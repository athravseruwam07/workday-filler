{
  "manifest_version": 3,
  "name": "Workday Filler",
  "version": "1.2.1",
  "description": "Fills Workday and Greenhouse job applications (experience, education, skills, websites, questions) from a markdown profile.",
  "permissions": [
    "storage",
    "activeTab",
    "debugger",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://*.workday.com/*",
    "https://*.greenhouse.io/*"
  ],
  "action": {
    "default_title": "Workday Filler",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://*.workday.com/*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.greenhouse.io/*"
      ],
      "js": [
        "parser.js",
        "content.js",
        "greenhouse.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}